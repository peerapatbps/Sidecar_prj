<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = ไม่มีหน้าต่าง console โผล่; ตัวเฝ้าทำงานเงียบๆ เบื้องหลัง -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TruckWatchdog</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Product>Truck Scale Software</Product>
    <AssemblyTitle>Truck Scale Watchdog</AssemblyTitle>
    <FileDescription>Truck Scale Watchdog</FileDescription>

    <!-- x86 self-contained single exe: รันได้บนเครื่องโรงงานที่มีแต่ .NET x86 -->
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <None Update="watchdog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
